{
  "version": 2,
  "env": {
    "PORT": "8080",
    "SESSION_SECRET": "sessionsecret"
    "SECRETHASH": "clavesecreta"
    "JWT_SECRET": "tokenjwt"

  },
  "builds": [
    {
      "src": "app.js",
      "use": "@vercel/node"
    }
  ],
  "routes": [
    {
      "src": "/(.*)",
      "dest": "app.js"
    }
  ]
}